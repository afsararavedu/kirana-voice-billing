# deploy/.env — infrastructure settings and database passwords for docker compose.
# Copy to deploy/.env on the VPS only (chmod 600). Never commit it. Placeholders only here.
#
# Passwords go inside connection URLs, so use URL-safe values — e.g. `openssl rand -hex 24`.
# They are applied when the database volume is first created; changing them later needs
# ALTER ROLE (see docs/deployment.md).

# Public hostname with a DNS A record pointing to this VPS, and the e-mail for Let's Encrypt.
DOMAIN=billing.example.in
ACME_EMAIL=owner@example.in

POSTGRES_SUPERUSER_PASSWORD=CHANGE_ME_hex48
KIRANA_OWNER_PASSWORD=CHANGE_ME_hex48
KIRANA_APP_PASSWORD=CHANGE_ME_hex48

# Host directory for database backups (created by root, owned by the container's postgres
# user: `sudo install -d -o 999 -g 999 -m 700 /var/backups/kirana`).
BACKUP_DIR=/var/backups/kirana
KEEP_DAYS=14
KEEP_MIN=7

LOG_LEVEL=info
