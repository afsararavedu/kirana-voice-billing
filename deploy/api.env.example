# deploy/api.env — application settings passed to the API container only. Copy to deploy/api.env
# on the VPS (chmod 600). Never commit it. DATABASE_URL, NODE_ENV, PORT, WEB_ORIGINS, COOKIE_SECURE
# and TRUST_PROXY are set by docker-compose.yml and must not be repeated here.

SESSION_TTL_HOURS=168
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20

# Voice billing. Defaults need no key. To use Claude for understanding orders, set
# VOICE_EXTRACTOR=anthropic and ANTHROPIC_API_KEY (server-side only; never in the web app).
SPEECH_PROVIDER=browser
VOICE_EXTRACTOR=rules
# ANTHROPIC_API_KEY=sk-ant-CHANGE_ME
# ANTHROPIC_MODEL=claude-opus-5-5
VOICE_LLM_TIMEOUT_MS=15000
VOICE_RATE_LIMIT_MAX=30
