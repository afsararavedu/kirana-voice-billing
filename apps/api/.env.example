# Copy to .env for local development. Placeholders only — never commit real values.
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Local dev DB started by `npm run dev:db` (embedded PostgreSQL on port 5433).
# Production: a least-privilege role that can read/write app tables but not create roles/databases.
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5433/kirana_dev?schema=public

# Comma-separated browser origins allowed to make state-changing requests.
WEB_ORIGINS=http://localhost:5173

# Session cookie. COOKIE_SECURE must be true in production (served over HTTPS).
SESSION_TTL_HOURS=168
COOKIE_SECURE=false

# Number of reverse-proxy hops in front of the API (1 behind Caddy/Nginx, 0 locally).
TRUST_PROXY=0

# Rate limits (requests per window, per client IP).
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20

# Voice billing (Phase 5). Keys stay on the server; the web bundle is checked for them at build.
# Speech: `browser` = the device's own recognizer (Chrome sends audio to Google's speech service;
# this app never receives audio). `none` = typed transcripts only.
SPEECH_PROVIDER=browser
# Understanding the transcript: `rules` = built-in parser (no key, no network);
# `anthropic` = Claude with structured output, falling back to `rules` on any failure.
VOICE_EXTRACTOR=rules
# Required only when VOICE_EXTRACTOR=anthropic. Model must be one of:
# claude-opus-5-5 (default), claude-sonnet-5-5, claude-haiku-5-5.
# ANTHROPIC_API_KEY=sk-ant-CHANGE_ME
# ANTHROPIC_MODEL=claude-opus-5-5
VOICE_LLM_TIMEOUT_MS=15000
# Voice requests per user per minute.
VOICE_RATE_LIMIT_MAX=30
